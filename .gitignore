# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Local Python environments
.venv*/
venv/
env/
ENV/

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Local package/build artifacts
build/
dist/
*.egg-info/

# Scraper output roots (when placed inside this repository)
/output/
/ekpa_desktop/
/[0-9]*/

# Generated course/test trees under any custom --output location.
# This also excludes student uploads and extracted source files.
course_*/
lesson_*/
test_[0-9]*/

# Runtime records, including custom output folders without a course tree yet
discovered_lessons.jsonl
history.jsonl
grade_upload_log.jsonl
students_index.jsonl
students.csv
students.before_sync.csv
exercise.txt
students_*.tmp
*.log

# Download completion and retry records
download_history.jsonl

# Lesson scan outcomes
download_scan_log.jsonl
